# Build output and staged distributions
dist/
build/

# Installers are published on the Releases page, never tracked here
release/*
!release/ClaimViewer.spec

# Local backups and the previous page kept by the updater
*.bak
*.bak-*
*.before-*
*.previous

# The built page holds somebody's claims, so it stays out of git
/index.html
/index.html.previous

# Account data written by the app
/library.json
/sources.js
/state.js
/state.json
/ai.json
/providers.json
/last-pages.json
/ocr.json
/perf.log
/pdf/
/data/

# Python
__pycache__/
*.pyc
.venv/

# Word component: credentials, logs and generated catalog state
word/localhost*.pem
word/localhost*.cer
word/*.log
word/catalog/
word/catalog-config.json
word/manifest.xml
word/service-config.json
word/manifest-acl-backup.txt
word/coordination-status.txt
word/verification.txt

# Test artefacts
tools/*.log
tools/*-result*.json
tools/*.txt
